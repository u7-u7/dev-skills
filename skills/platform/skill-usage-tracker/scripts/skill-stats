#!/usr/bin/env bash
set -euo pipefail

# Unified skill-stats entrypoint that works across repositories/cwd.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_PATH="$(cd "$SCRIPT_DIR" && pwd)/$(basename "$0")"

run_python_fallback() {
  python3 "$SCRIPT_DIR/update_stats.py" "$@"
}

# 1) Prefer current repo entrypoint (if caller is in a repo that has scripts/skill-stats)
if ROOT_DIR=$(git rev-parse --show-toplevel 2>/dev/null); then
  CANDIDATE="$ROOT_DIR/scripts/skill-stats"
  if [[ -x "$CANDIDATE" ]]; then
    CANDIDATE_REAL="$(cd "$(dirname "$CANDIDATE")" && pwd)/$(basename "$CANDIDATE")"
    if [[ "$CANDIDATE_REAL" != "$SELF_PATH" ]]; then
      exec "$CANDIDATE" "$@"
    fi
  fi
fi

# 2) If SKILL_DIR is provided by runtime, try that repo entrypoint
if [[ -n "${SKILL_DIR:-}" ]]; then
  CANDIDATE="$SKILL_DIR/../../../scripts/skill-stats"
  if [[ -x "$CANDIDATE" ]]; then
    exec "$CANDIDATE" "$@"
  fi
fi

# 3) Direct fallback to python updater in current skill package
run_python_fallback "$@"

